# Optional Hugging Face access token for gated/private model artifacts.
HF_TOKEN=

# Use mock for local smoke tests. Use transformers after installing the ml extras.
MODEL_BACKEND=mock
BASE_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct
ADAPTER_PATH=./artifacts/adapters/checkpoint-51

# Optional RAG artifacts downloaded from Google Drive.
RAG_INDEX_PATH=./artifacts/rag/codesearchnet_python.faiss
RAG_DOCUMENTS_PATH=./artifacts/rag/documents.jsonl
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

MAX_REPAIR_ATTEMPTS=2
EXECUTION_TIMEOUT_SECONDS=5
